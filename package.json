{
    "name": "@giveback007/util-lib",
    "version": "4.1.0",
    "description": "Utility library",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "[--NOTES--]": [
        "run `npm login` first, then run `npm run pub`"
    ],
    "scripts": {
        "pub": "rm -rf dist && npm run build && npm login && npm publish",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test": "deno run --watch test.ts"
    },
    "files": [
        "/dist",
        "/src"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Giveback007/util-lib.git"
    },
    "keywords": [],
    "author": "Dovydas Stirpeika <dovy91@gmail.com>",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Giveback007/util-lib/issues"
    },
    "homepage": "https://github.com/Giveback007/util-lib#readme",
    "dependencies": {
        "@js-temporal/polyfill": "^0.5.1",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "typescript": "5.9.3"
    }
}